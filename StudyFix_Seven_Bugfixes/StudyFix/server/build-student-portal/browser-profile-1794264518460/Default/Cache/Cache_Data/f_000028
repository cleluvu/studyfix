export const dashboardPages=['admin','admin-statistics','admin-settings','admin-notifications'];
const fresh=()=>({owner:'',data:null,error:'',busy:false,actionBusy:false,filters:{days:'',classId:'',weekId:'',verdict:'',page:1},request:0,lastLoad:0});
export const dashboard=fresh();
let adminAction;
export function configureDashboard(action){adminAction=action;}
function scope(){const owner=`${state.identity?.userId}:${state.token}`;if(dashboard.owner!==owner){Object.assign(dashboard,fresh(),{owner});state.teacherDashboardUnread=0;}}
export async function loadTeacherDashboard(){
 scope();if(state.identity?.role!=='TEACHER'||!dashboardPages.includes(state.page))return;
 const owner=dashboard.owner,request=++dashboard.request;dashboard.busy=true;
 const query=new URLSearchParams(Object.entries(state.page==='admin-statistics'?dashboard.filters:{days:dashboard.filters.days}).filter(([,v])=>v!==''));
 try{const result=await api(`/api/teacher/dashboard?${query}`);if(owner!==dashboard.owner||owner!==`${state.identity?.userId}:${state.token}`||request!==dashboard.request)return;dashboard.data=result.data;state.teacherDashboardUnread=result.data.unread;dashboard.error='';dashboard.lastLoad=Date.now();if(!dashboard.filters.days)dashboard.filters.days=String(result.data.settings.days||30);}
 catch(e){if(owner===dashboard.owner&&request===dashboard.request)dashboard.error=e.message;}
 finally{if(owner===dashboard.owner&&request===dashboard.request)dashboard.busy=false;}
}
const num=n=>Number(n||0).toLocaleString('vi-VN');
const stamp=n=>n?new Date(Number(n)).toLocaleString('vi-VN',{timeZone:'Asia/Bangkok',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}):'Chưa có hoạt động';
function ago(n){const diff=Math.max(0,Date.now()-Number(n));return diff<60000?'Vừa xong':diff<3600000?`${Math.floor(diff/60000)} phút trước`:diff<86400000?`${Math.floor(diff/3600000)} giờ trước`:stamp(n);}
const button=(label,action,attrs='',cls='')=>`<button type="button" class="td-button ${cls}" data-action="td-${action}" ${attrs}>${label}</button>`;
const link=(label,action,attrs='')=>button(`${label} ${icon('arrow')}`,action,attrs,'td-link');
const empty=text=>`<div class="td-empty">${icon('info')}<p>${text}</p></div>`;
const panel=(title,symbol,body,action='',cls='')=>`<section class="td-panel ${cls}"><div class="td-panel-head"><h3>${icon(symbol)}${title}</h3>${action}</div>${body}</section>`;
const heroArt=`<svg class="td-hero-art" viewBox="0 0 340 115" aria-hidden="true"><defs><linearGradient id="td-laptop" x2="1" y2="1"><stop stop-color="#b4a0ff"/><stop offset="1" stop-color="#6332df"/></linearGradient></defs><path d="M7 104H329" stroke="#aa8bf8" stroke-width="5" stroke-linecap="round"/><rect x="31" y="72" width="84" height="14" rx="6" fill="#fff" stroke="#8861f0" stroke-width="3"/><rect x="36" y="57" width="79" height="14" rx="6" fill="#fff" stroke="#fb707c" stroke-width="3"/><rect x="69" y="58" width="40" height="13" rx="4" fill="#9a73ee"/><path d="m126 14-10 75h111l10-75Z" fill="url(#td-laptop)" stroke="#6430e2" stroke-width="4"/><path d="m135 23-8 57h91l8-57Z" fill="#b69af9"/><path d="m159 42-12 12 10 10m36-22 11 12-14 10m-11-26-10 31" fill="none" stroke="white" stroke-width="4" stroke-linecap="round"/><path d="M109 89h131l-15 11H111Z" fill="#8155e9"/><path d="m270 65 4 35h28l5-35" fill="#7341d9"/><path d="m280 68-5-36m17 35 5-39m-10 38 9-23" stroke="#9162e3" stroke-width="5"/><path d="m275 32-1-6m23 2 1-6" stroke="#ffb94e" stroke-width="5"/></svg>`;
function heading(title='Tổng quan giảng viên',subtitle='Chào mừng trở lại! Dưới đây là tổng quan hoạt động giảng dạy của bạn.'){
 return `<div class="td-hero"><div class="td-title-icon">${icon('graduate')}</div><div><h2>${title}</h2><p>${subtitle}</p></div>${heroArt}</div>`;
}
function range(){return `<label class="td-range"><span class="sr-only">Khoảng thời gian thống kê</span><select data-td-filter="days">${[7,30,90].map(v=>`<option value="${v}" ${Number(dashboard.filters.days||30)===v?'selected':''}>${v} ngày gần nhất</option>`).join('')}</select></label>`;}
function cards(d){return `<div class="td-stats">${[
 ['users',d.stats.classes,'Lớp học đang quản lý','classes','purple'],['users',d.stats.students,'Sinh viên','students','green'],['code',d.stats.assignments,'Bài tập đã giao','assignments','purple'],['exam',d.stats.exams,'Đề thi trong ngân hàng','exam-bank','purple'],['play',d.stats.liveLessons,'Phiên học đang diễn ra','rooms','green']
 ].map(([symbol,value,label,action,tone])=>button(`<span class="td-stat-icon ${tone}">${icon(symbol)}</span><span><strong>${num(value)}</strong><span>${label}</span><small>${action==='rooms'?'Cập nhật theo phiên học':'Trong phạm vi giảng dạy của bạn'}</small></span>`,action,'','td-stat')).join('')}</div>`;}
function lineChart(d){
 const rows=d.learning.daily||[],map=new Map(rows.map(r=>[r.day,r])),days=Number(d.learning.days||30),points=[];
 for(let i=0;i<days;i++){const time=Number(d.learning.since)+i*86400000,key=new Date(time+7*3600000).toISOString().slice(0,10),row=map.get(key)||{};points.push({key,n:Number(row.submissions||0),ac:Number(row.accepted||0)});}
 const max=Math.max(5,...points.map(p=>p.n)),ceiling=Math.ceil(max/5)*5,x=i=>46+i*510/Math.max(1,days-1),y=n=>178-n*145/ceiling;
 const path=field=>points.map((p,i)=>`${i?'L':'M'}${x(i).toFixed(1)},${y(p[field]).toFixed(1)}`).join(' ');
 return `<div class="td-chart-legend"><span><i style="background:#7835ff"></i>Lượt nộp</span><span><i style="background:#28c64d"></i>Lượt AC</span></div><svg class="td-line-chart" viewBox="0 0 580 211" role="img" aria-label="Lượt nộp và lượt AC theo ngày"><defs><linearGradient id="td-area" x2="0" y2="1"><stop stop-color="#9259ff" stop-opacity=".24"/><stop offset="1" stop-color="#9259ff" stop-opacity=".01"/></linearGradient></defs>${Array.from({length:6},(_,i)=>`<path d="M46 ${y(i*ceiling/5)}H556" stroke="#edeaf6"/><text x="34" y="${y(i*ceiling/5)+4}" text-anchor="end">${num(i*ceiling/5)}</text>`).join('')}<path d="${path('n')} L556 178 L46 178Z" fill="url(#td-area)"/><path d="${path('n')}" stroke="#7835ff" stroke-width="2.4" fill="none"/><path d="${path('ac')}" stroke="#28c64d" stroke-width="2.3" fill="none"/>${points.map((p,i)=>`<g tabindex="0"><title>${p.key}: ${p.n} lượt nộp; ${p.ac} AC</title><circle cx="${x(i)}" cy="${y(p.n)}" r="${days>30?2:3}" stroke="#7835ff" fill="white"/><circle cx="${x(i)}" cy="${y(p.ac)}" r="${days>30?1.8:2.6}" stroke="#28c64d" fill="white"/>${i%Math.ceil(days/7)===0?`<text x="${x(i)}" y="200" text-anchor="middle">${p.key.slice(8)}/${p.key.slice(5,7)}</text>`:''}</g>`).join('')}</svg>${rows.length?'':'<p class="td-chart-note">Chưa có lượt nộp trong khoảng thời gian này.</p>'}`;
}
const colors={AC:'#2dcc40',WA:'#ff595b',TLE:'#ffb51e',CE:'#9674f8',RE:'#c5c6d0',OTHER:'#6488d6',PENDING:'#b9afd4'};
function donut(d){const counts=Object.fromEntries((d.learning.verdicts||[]).map(r=>[r.verdict,Number(r.count)])),total=Object.entries(counts).filter(([v])=>v!=='PENDING').reduce((sum,[,n])=>sum+n,0);let angle=0;const stops=Object.entries(colors).filter(([v])=>v!=='PENDING').map(([v,c])=>{const start=angle;angle+=total?(counts[v]||0)*360/total:0;return `${c} ${start}deg ${angle}deg`;}).join(',');return `<div class="td-result-chart"><div class="td-donut" style="background:${total?`conic-gradient(${stops})`:'#ece8f6'}"><div><strong>${total?((counts.AC||0)/total*100).toFixed(1)+'%':'—'}</strong><span>AC</span></div></div><div class="td-verdicts">${Object.entries(colors).filter(([v])=>v!=='OTHER'||counts.OTHER).filter(([v])=>v!=='PENDING'||counts.PENDING).map(([v,c])=>button(`<i style="background:${c}"></i><span>${v==='PENDING'?'Đang chấm':v==='OTHER'?'Khác':v}: <b>${v==='PENDING'?num(counts[v]):`${total?((counts[v]||0)/total*100).toFixed(1):'0.0'}%`}</b> (${num(counts[v])})</span>`,'verdict',`data-verdict="${v}"`,'td-verdict')).join('')}</div></div>`;}
function classRows(d){return (d.classes||[]).filter(c=>c.active).slice().sort((a,b)=>Number(b.lastLessonActivity||0)-Number(a.lastLessonActivity||0));}
function recentClasses(d){const rows=classRows(d).slice(0,5);return rows.length?`<div class="td-table-wrap"><table class="td-table"><thead><tr><th>Mã lớp</th><th>Tên lớp học</th><th>Số SV</th><th>Hoạt động gần nhất</th><th>Trạng thái</th><th><span class="sr-only">Thao tác</span></th></tr></thead><tbody>${rows.map(c=>{const live=!['WAITING','ENDED'].includes(c.phase||'WAITING'),closed=!!c.closed;return `<tr><td><strong>${esc(c.roomCode)}</strong></td><td>${esc(c.name)}</td><td>${num(c.memberCount)}</td><td>${stamp(c.lastLessonActivity)}</td><td><span class="td-badge ${closed?'gray':'green'}">${closed?'Đã đóng':live?'Đang diễn ra':'Đang hoạt động'}</span></td><td><div class="td-row-actions">${button(icon('play'),'enter',`data-id="${esc(c.classId)}" aria-label="Vào lớp ${esc(c.roomCode)}" ${closed?'disabled':''}`,'td-icon-button')}${button('⋮','class-menu',`data-id="${esc(c.classId)}" aria-label="Thao tác lớp ${esc(c.roomCode)}"`,'td-icon-button')}</div></td></tr>`;}).join('')}</tbody></table></div>`:empty('Chưa có lớp học. Chọn “Tạo lớp học” để bắt đầu.');}
function activity(d,all=false){const rows=(d.activity||[]).slice(0,all?50:5);return rows.length?`<div class="td-activity">${rows.map(a=>button(`<span class="td-event-icon ${a.kind==='submission'?'green':''}">${icon(({submission:'code',member:'users',assignment:'exam',lesson:'clock',exam:'exam'})[a.kind]||'clock')}</span><span><strong>${esc(a.title)}</strong>${a.kind==='submission'?'':`<small>${esc(a.context)}</small>`}</span><time datetime="${new Date(Number(a.at)).toISOString()}">${ago(a.at)}</time>`,'activity',`data-id="${esc(a.id)}"`,`td-event ${Number(a.at)>Number(d.readAt||0)?'td-unread':''}`)).join('')}</div>`:empty('Chưa có hoạt động gần đây.');}
function upcoming(d){return (d.learning.upcoming||[]).length?d.learning.upcoming.map(e=>`<div class="td-upcoming"><span class="td-event-icon">${icon('exam')}</span><div><strong>${esc(e.title)}</strong><small>${icon('calendar')}${stamp(e.startAt)}</small></div>${button('Chi tiết','exam',`data-id="${esc(e.id)}"`,'td-outline')}</div>`).join(''):empty('Chưa có kỳ thi sắp diễn ra.');}
function weeks(d){const rows=(d.learning.weekProgress||[]).slice(0,3);return rows.length?`<div class="td-weeks">${rows.map(w=>button(`<span>Week ${w.weekNo} – ${esc(w.title)}<strong>${w.percent}%</strong></span><span class="td-progress-track"><span style="width:${Math.min(100,Number(w.percent))}%"></span></span><small>${num(w.completed)}/${num(w.total)} lượt hoàn thành</small>`,'week',`data-id="${esc(w.id)}"`,'td-week')).join('')}</div>`:empty('Chưa có tiến độ Week từ các bài đã giao.');}
function quick(){return `<div class="td-quick-grid">${[['plus','Tạo lớp học','create-class'],['video','Mở phòng học','rooms'],['code','Giao bài tập','assign'],['exam','Tạo kỳ thi','create-exam']].map(([i,t,a])=>button(`${icon(i)}<strong>${t}</strong>`,a)).join('')}</div>`;}
function filterBar(d){return `<div class="td-filters">${range()}<select data-td-filter="classId" aria-label="Lọc lớp học"><option value="">Tất cả lớp</option>${d.classes.map(c=>`<option value="${esc(c.classId)}" ${dashboard.filters.classId===c.classId?'selected':''}>${esc(c.roomCode)} · ${esc(c.name)}</option>`).join('')}</select><select data-td-filter="weekId" aria-label="Lọc Week"><option value="">Tất cả Week</option>${d.learning.weeks.map(w=>`<option value="${esc(w.id)}" ${dashboard.filters.weekId===w.id?'selected':''}>Week ${w.weekNo} – ${esc(w.title)}</option>`).join('')}</select><select data-td-filter="verdict" aria-label="Lọc kết quả"><option value="">Tất cả kết quả</option>${Object.keys(colors).map(v=>`<option value="${v}" ${dashboard.filters.verdict===v?'selected':''}>${v==='OTHER'?'Khác':v==='PENDING'?'Đang chấm':v}</option>`).join('')}</select>${button('Xóa bộ lọc','reset')}</div>`;}
function submissions(d){const l=d.learning;return `<p class="td-chart-note">${num(l.total)} bài nộp · Loại lượt chạy thử và kiểm định. Bài đang chấm chưa tính vào tỷ lệ kết quả.</p>${l.submissions.length?`<div class="td-table-wrap"><table class="td-table"><thead><tr><th>Sinh viên</th><th>Bài tập</th><th>Nguồn</th><th>Thời điểm nộp</th><th>Kết quả</th><th>Điểm</th></tr></thead><tbody>${l.submissions.map(s=>`<tr><td>${esc(s.student)}</td><td>${esc(s.title)}<small>${esc(s.exerciseId)}</small></td><td>${esc(s.source)}</td><td>${stamp(s.submittedAt)}</td><td><span class="td-badge ${s.verdict==='AC'?'green':'gray'}">${esc(s.status==='DONE'?s.verdict:s.status)}</span></td><td>${s.status==='DONE'?num(s.score):'—'}</td></tr>`).join('')}</tbody></table></div>`:empty('Không có bài nộp phù hợp bộ lọc.')}<div class="td-pagination">${button('← Trước','page',`data-page="${l.page-1}" ${l.page<=1?'disabled':''}`)}<span>Trang ${l.page}/${l.totalPages}</span>${button('Sau →','page',`data-page="${l.page+1}" ${l.page>=l.totalPages?'disabled':''}`)}</div>`;}
function settings(d){const s=d.settings;return panel('Cài đặt cá nhân','settings',`<form id="td-settings-form" class="td-settings"><label>Khoảng thời gian thống kê mặc định<select name="days">${[7,30,90].map(n=>`<option value="${n}" ${Number(s.days)===n?'selected':''}>${n} ngày</option>`).join('')}</select></label><label class="td-checkbox"><input name="notifications" type="checkbox" ${s.notifications!==false?'checked':''}> Hiển thị số thông báo chưa đọc</label><label class="td-checkbox"><input name="compact" type="checkbox" ${s.compact?'checked':''}> Hiển thị bảng gọn hơn</label><p>Ngày giờ hiển thị theo UTC+7. Các tùy chọn được lưu riêng theo tài khoản.</p><button class="td-button td-primary" type="submit">Lưu cài đặt</button><p id="td-settings-message" role="status"></p></form>`);}
export function renderTeacherDashboard(){scope();const d=dashboard.data,stats=state.page==='admin-statistics',notifications=state.page==='admin-notifications',setting=state.page==='admin-settings';
 const top=heading(setting?'Cài đặt':notifications?'Thông báo & hoạt động':stats?'Thống kê giảng dạy':undefined,setting?'Tùy chỉnh không gian làm việc của bạn.':notifications?'Theo dõi các hoạt động trong phạm vi giảng dạy.':stats?'Chi tiết bài nộp, kết quả chấm và tiến độ theo lớp.':undefined);
 const error=dashboard.error?`<div class="notice-box warn" role="alert">${esc(dashboard.error)} ${button('Thử lại','refresh')}</div>`:'';
 if(!d)return `<div class="td-dashboard">${top}${error}${empty(dashboard.busy?'Đang tải dữ liệu tổng quan…':'Dữ liệu chưa sẵn sàng.')}</div>`;
 if(setting)return `<div class="td-dashboard">${top}${error}${settings(d)}</div>`;
 if(notifications)return `<div class="td-dashboard">${top}${error}${panel('Hoạt động gần đây','clock',activity(d,true),button('Đánh dấu tất cả đã đọc','read'))}${d.joinRequests?.length?panel('Yêu cầu tham gia lớp','users',d.joinRequests.map(r=>`<div class="td-upcoming"><div><strong>${esc(r.displayName||r.studentCode)}</strong><small>${esc(r.roomCode)}</small></div><div class="td-row-actions"><button type="button" class="td-button" data-action="admin-approve-join" data-class-id="${esc(r.classId)}" data-id="${esc(r.userId)}" data-request-id="${esc(r.requestId)}" data-requested-at="${Number(r.requestedAt)}">Chấp nhận</button><button type="button" class="td-button" data-action="admin-reject-join" data-class-id="${esc(r.classId)}" data-id="${esc(r.userId)}" data-request-id="${esc(r.requestId)}" data-requested-at="${Number(r.requestedAt)}">Từ chối</button></div></div>`).join('')):''}</div>`;
 const charts=`<div class="td-charts">${panel('Hoạt động luyện code của sinh viên','users',lineChart(d),range())}${panel('Tỷ lệ kết quả chấm','chart',donut(d))}</div>`;
 if(stats)return `<div class="td-dashboard ${d.settings.compact?'td-compact':''}">${top}${error}${filterBar(d)}${charts}${panel('Bài nộp của sinh viên','code',submissions(d))}${panel('Tiến độ theo Week','layers',weeks(d))}</div>`;
 return `<div class="td-dashboard ${d.settings.compact?'td-compact':''}">${top}${error}${cards(d)}<div class="td-body"><div class="td-main">${charts}<div class="td-lower">${panel('Lớp học gần đây','users',recentClasses(d),link('Xem tất cả lớp','classes'))}${panel('Hoạt động gần đây','clock',activity(d),link('Xem tất cả','notifications'))}</div></div><aside class="td-side">${panel('Thao tác nhanh','bolt',quick())}${panel('Kỳ thi sắp diễn ra','calendar',upcoming(d),link('Xem tất cả','exams'))}${panel('Tiến độ theo Week <small>(tất cả lớp)</small>','layers',weeks(d))}</aside></div><div class="td-sync"><span>Cập nhật ${stamp(d.serverTime)}</span>${button(dashboard.busy?'Đang tải…':'Làm mới','refresh',dashboard.busy?'disabled':'')}</div></div>`;
}
async function refresh(){await loadTeacherDashboard();render();}
async function statistics(filter={}){Object.assign(dashboard.filters,filter,{page:1});await navigate('admin-statistics');}
function chooseClass(action){const d=dashboard.data,rows=classRows(d).filter(c=>c.active&&!c.closed);modal(`<div class="modal-head"><h3>${action==='assign'?'Chọn lớp để giao bài':'Chọn phòng học'}</h3><button class="btn btn-soft" data-action="close-modal">Đóng</button></div><div class="modal-body">${rows.length?rows.map(c=>`<div class="td-upcoming"><div><strong>${esc(c.roomCode)}</strong><small>${esc(c.name)}</small></div>${button(action==='assign'?'Giao bài':'Vào phòng',action==='assign'?'work':'enter',`data-id="${esc(c.classId)}"`)}</div>`).join(''):empty('Bạn chưa có lớp đang mở. Hãy tạo lớp trước.')}</div>`);}
export async function dashboardClick(action,data={}){
 scope();if(state.identity?.role!=='TEACHER'||dashboard.actionBusy)return;
 dashboard.actionBusy=true;const owner=dashboard.owner;
 const controls=[...document.querySelectorAll('[data-action^="td-"]')].map(el=>[el,el.disabled]);controls.forEach(([el])=>el.disabled=true);
 try{await handleDashboardClick(action,data);}
 finally{if(dashboard.owner===owner)dashboard.actionBusy=false;controls.forEach(([el,disabled])=>{if(el.isConnected)el.disabled=disabled;});}
}
async function handleDashboardClick(action,data={}){scope();
 switch(action.replace('td-','')){
 case 'refresh':await refresh();break;
 case 'classes':await navigate('admin-classes');break;
 case 'students':await navigate('admin-students');break;
 case 'assignments':await navigate('admin-assignments');break;
 case 'exam-bank':await navigate('exam-bank');break;
 case 'notifications':await navigate('admin-notifications');break;
 case 'create-class':await adminAction('admin-create-class',{});break;
 case 'rooms':case 'assign':chooseClass(action==='td-assign'?'assign':'rooms');break;
 case 'create-exam':case 'exams':case 'exam':{const {organizationClick}=await import('../exam-organization/index.js');await organizationClick(action==='td-exam'?'eo-open':'eo-nav',action==='td-exam'?{id:data.id}:{view:action==='td-create-exam'?'create':'list'});break;}
 case 'class-menu':{const c=dashboard.data.classes.find(c=>c.classId===data.id);if(!c)return;modal(`<div class="modal-head"><h3>${esc(c.roomCode)} · ${esc(c.name)}</h3><button class="btn btn-soft" data-action="close-modal">Đóng</button></div><div class="modal-body td-class-menu">${button('Chi tiết lớp','class',`data-id="${esc(c.classId)}"`)}${button('Sửa tên lớp','edit-class',`data-id="${esc(c.classId)}"`)}${button('Kết nối & điểm danh','connections',`data-id="${esc(c.classId)}"`)}</div>`);break;}
 case 'class':clearModal();await adminAction('admin-select-class',{id:data.id});break;
 case 'edit-class':await adminAction('admin-edit-class',{id:data.id});break;
 case 'connections':clearModal();await adminAction('admin-select-class',{id:data.id});await navigate('admin-connections');break;
 case 'enter':case 'work':clearModal();await adminAction(action==='td-enter'?'admin-enter-class':'admin-work-class',{id:data.id});break;
 case 'verdict':await statistics({verdict:data.verdict});break;
 case 'week':await statistics({weekId:data.id});break;
 case 'page':dashboard.filters.page=Number(data.page);await refresh();break;
 case 'reset':dashboard.filters={days:String(dashboard.data?.settings.days||30),classId:'',weekId:'',verdict:'',page:1};await refresh();break;
 case 'activity':{const row=dashboard.data.activity.find(a=>a.id===data.id);if(row?.contestId){const {organizationClick}=await import('../exam-organization/index.js');await organizationClick('eo-open',{id:row.contestId});}else if(row?.classId)await adminAction('admin-select-class',{id:row.classId});else await statistics();break;}
 case 'read':{const through=Math.max(0,...dashboard.data.activity.map(a=>Number(a.at)));await api('/api/teacher/dashboard',{method:'POST',body:{action:'READ',through}});await refresh();toast('Đã đánh dấu thông báo đã đọc.','success');break;}
 }
}
document.addEventListener('change',async e=>{if(!e.target.matches('[data-td-filter]')||state.identity?.role!=='TEACHER')return;dashboard.filters[e.target.dataset.tdFilter]=e.target.value;dashboard.filters.page=1;try{await refresh();}catch(err){toast(err.message,'error');}});
document.addEventListener('submit',async e=>{if(e.target.id!=='td-settings-form')return;e.preventDefault();const form=e.target,submit=form.querySelector('[type="submit"]');submit.disabled=true;try{const values=new FormData(form);const result=await api('/api/teacher/dashboard',{method:'POST',body:{action:'SETTINGS',days:Number(values.get('days')),compact:values.has('compact'),notifications:values.has('notifications')}});dashboard.data.settings=result.data.settings;dashboard.filters.days=String(result.data.settings.days);form.querySelector('[role="status"]').textContent='Đã lưu cài đặt.';}catch(err){form.querySelector('[role="status"]').textContent=err.message;}finally{submit.disabled=false;}});
