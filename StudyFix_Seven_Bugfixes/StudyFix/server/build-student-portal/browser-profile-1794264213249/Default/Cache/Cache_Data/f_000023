document.addEventListener("studyfix:exam-update",e=>{if(!active()||o.view==="create"||o.busy)return;const pulse=JSON.stringify(e.detail?.organization||{});if(pulse!==o.pulse){o.pulse=pulse;if(Date.now()-o.lastLoaded>1500){o.lastLoaded=0;void poll();}}});
addRenderHook(()=>{const all=document.getElementById("eo-select-all");if(all){const count=o.directory.exams.filter(e=>o.selected.has(e.id)).length;all.checked=!!count&&count===o.directory.exams.length;all.indeterminate=count>0&&count<o.directory.exams.length;}});
const organizationClock=setInterval(()=>{if(!active())return;for(const el of document.querySelectorAll("[data-eo-countdown]")){const offset=(o.detail?.serverTime||Date.now())-o.lastLoaded;el.textContent=countdown(Math.max(0,Number(el.dataset.end)-(Date.now()+offset)));}},1000);

organizationClock?.unref?.();
