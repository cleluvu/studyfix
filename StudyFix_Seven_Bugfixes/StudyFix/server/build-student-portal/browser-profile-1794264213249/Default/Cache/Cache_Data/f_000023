 if(el.id==="eo-candidate-all"){for(const node of document.querySelectorAll("[data-eo-candidate]")){const id=node.dataset.eoCandidate;el.checked?o.candidates.add(id):o.candidates.delete(id);}render();return;}
 if(el.id==="eo-submission-all"){for(const s of o.detail.submissions)el.checked?o.submissions.add(s.id):o.submissions.delete(s.id);render();return;}
 if(el.id==="eo-exam-select"){if(el.value)await go(o.view==="detail"?"detail":o.view,el.value);return;}
 const filter=({"eo-filter-status":"filterStatus","eo-filter-subject":"subject","eo-filter-format":"format","eo-list-size":"pageSize"})[el.id];if(filter){o.filters[filter]=filter==="pageSize"?Number(el.value):el.value;o.filters.page=1;o.selected.clear();await directory();render();return;}
 const prop=({"eo-monitor-status":"monitorStatus","eo-candidate-class":"candidateClass","eo-candidate-room":"candidateRoom","eo-candidate-status":"candidateStatus","eo-candidate-size":"candidatePageSize","eo-submission-size":"submissionPageSize","eo-result-room":"resultRoom","eo-result-exercise":"exerciseId","eo-result-status":"submissionStatus","eo-result-verdict":"verdict"})[el.id];if(prop){o[prop]=["candidatePageSize","submissionPageSize"].includes(prop)?Number(el.value):el.value;o.candidatePage=1;if(prop.startsWith("candidate")||prop==="monitorStatus")render();else{o.submissionPage=1;o.submissions.clear();await detail();render();}return;}
