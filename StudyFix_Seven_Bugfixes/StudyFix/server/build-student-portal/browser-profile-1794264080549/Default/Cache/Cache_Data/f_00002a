import {organization as o,viewNames,statuses,formats} from "./state.js";
import {state} from "../../core/state.js";
import {esc} from "../../shared/format.js";
import {templateIcon} from "../../ui/template.js";
import {renderContestWorkspace} from "../contests/contests.js";

const extra={monitor:'<rect x="3" y="3" width="18" height="14" rx="2"/><path d="M12 17v4m-5 0h10"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/>',play:'<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4V8Z"/>',warning:'<path d="m12 3 10 18H2L12 3Zm0 6v5m0 3v1"/>',copy:'<rect x="8" y="7" width="12" height="14" rx="2"/><path d="M16 7V3H4v14h4"/>',lock:'<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/>',shuffle:'<path d="M3 6h3c6 0 6 12 12 12h3m-4-4 4 4-4 4M3 18h3c2 0 4-3 6-6s4-6 6-6h3m-4-4 4 4-4 4"/>',stop:'<rect x="5" y="5" width="14" height="14" rx="2"/>',close:'<path d="m6 6 12 12M6 18 18 6"/>',more:'<circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>'};
export const icon=name=>extra[name]?`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${extra[name]}</svg>`:templateIcon(name);
export const button=(label,action,style="outline",attrs="",symbol="")=>`<button type="button" class="eo-btn ${style}" data-action="eo-${action}"  ${attrs}>${symbol?icon(symbol):""}${label}</button>`;
const tool=(symbol,action,id,label,attrs="")=>`<button class="eo-tool" type="button" data-action="eo-${action}" data-id="${esc(id)}" title="${esc(label)}" aria-label="${esc(label)}" ${attrs}>${icon(symbol)}</button>`;
export const date=(time,options={})=>time?new Intl.DateTimeFormat("vi-VN",{day:"2-digit",month:"2-digit",year:"numeric",timeZone:o.detail?.exam?.timezone||"Asia/Bangkok",...options}).format(new Date(Number(time))):"—";
export const time=value=>date(value,{hour:"2-digit",minute:"2-digit",day:undefined,month:undefined,year:undefined});
const number=value=>new Intl.NumberFormat("vi-VN",{maximumFractionDigits:2}).format(Number(value)||0);
export const badge=(label,color="purple")=>`<span class="eo-badge ${color}"><i></i>${esc(label)}</span>`;
const phase=e=>badge(statuses[e.status]||e.status,({RUNNING:"green",SCHEDULED:"amber",POSTPONED:"red",CANCELLED:"red",FINISHED:"green",DRAFT:"gray"})[e.status]||"purple");
const empty=(title,description="")=>`<div class="eo-empty">${icon("calendar")}<strong>${esc(title)}</strong><p>${esc(description)}</p></div>`;
const heading=(title,subtitle,symbol="calendar",actions="")=>`<header class="eo-heading"><div class="eo-heading-icon">${icon(symbol)}</div><div><h1>${title}</h1><p>${subtitle}</p></div><div class="eo-heading-actions">${actions}</div></header>`;
const stat=(label,value,symbol,color="purple")=>`<article class="eo-card eo-stat ${color}"><span class="eo-stat-icon">${icon(symbol)}</span><div><p>${label}</p><strong>${number(value)}</strong></div><span class="eo-stat-watermark">${icon(symbol)}</span></article>`;
const select=(id,label,options,value="")=>`<select id="${id}" aria-label="${label}">${options.map(([v,l])=>`<option value="${esc(v)}" ${String(value)===String(v)?"selected":""}>${esc(l)}</option>`).join("")}</select>`;
const checked=value=>value?"checked":"";
const isOwner=()=>o.detail?.exam?.access==="OWNER";
export const eligible=()=>{const ids=o.draft?.document.classIds||[];return [...new Map(o.sources.students.filter(s=>ids.includes(s.classId)).map(s=>[s.id,s])).values()];};
const summary=()=>{const d=o.draft?.document||{},e=o.definition||o.sources.exams.find(e=>e.id===d.examVersionId)||{},points=d.distributionMode==="RANDOM"&&e.items?.length?Number(e.items[0].points)*d.problemsPerStudent:e.totalPoints||0;return `<section class="eo-card eo-summary"><h3>${icon("layers")} Tóm tắt kỳ thi</h3>${[["Đề thi",e.title||"Chưa chọn","layers","purple"],["Số thí sinh",d.studentIds?.length||0,"users","blue"],["Tổng điểm",number(points)+" điểm","check","amber"],["Thời lượng",(d.durationMinutes||0)+" phút","clock","green"]].map(([label,value,symbol,color])=>`<div class="eo-summary-item ${color}">${icon(symbol)}<div><small>${label}</small><strong>${esc(value)}</strong></div></div>`).join("")}</section>`;};
export function renderOrganization(){
 if(!state.identity)return "";
 const teacher=state.identity.role==="TEACHER";
 return `<div class="eo" ${o.busy?'aria-busy="true"':""}>${o.error?`<div class="eo-alert error" role="alert">${icon("warning")}<span>${esc(o.error)}</span>${button("Thử lại","reload","small")}</div>`:""}${o.busy?'<div class="eo-loading" role="status">Đang xử lý dữ liệu kỳ thi…</div>':""}${o.view==="create"&&teacher?creator():o.view==="list"?directory(teacher):!o.detail?`${heading(viewNames[o.view]||"Kỳ thi","Chọn kỳ thi để tiếp tục")}${examSelector()}${empty("Chưa chọn kỳ thi","Mở một kỳ thi trong danh sách hoặc chọn phía trên.")}`:o.view==="assign"?assignment():o.view==="monitor"?monitor():o.view==="results"?results():detail(teacher)}${o.detail&&["assign","monitor","results"].includes(o.view)?messages():""}</div>`;
}
function studentDirectory(){
 const d=o.directory,exams=d.exams||[];
 const groups=[['Sắp diễn ra',['SCHEDULED','POSTPONED'],'clock'],['Đang diễn ra',['RUNNING'],'play'],['Đã kết thúc',['FINISHED','ENDED','CANCELLED'],'check']];
 return `<div class="student-portal">${heading('Kỳ thi của tôi','Chỉ các kỳ thi bạn được phân công. Vào thi và xem kết quả theo quyền do giảng viên thiết lập.')}<div class="eo-toolbar"><label class="eo-search">${icon('search')}<input id="eo-search" type="search" value="${esc(o.filters.query)}" placeholder="Tìm kiếm kỳ thi…" aria-label="Tìm kiếm kỳ thi"></label>${select('eo-filter-status','Trạng thái kỳ thi',[["","Tất cả trạng thái"],...Object.entries(statuses).filter(([v])=>v!=='DRAFT')],o.filters.filterStatus)}${button('Làm mới','reload','outline','','history')}</div><div class="sp-exam-groups">${groups.map(([label,states,symbol])=>{const rows=exams.filter(e=>states.includes(e.status));return `<section class="card sp-panel"><div class="card-head"><h3>${icon(symbol)} ${label}</h3><span class="sp-badge">${rows.length} kỳ thi trên trang</span></div><div class="card-body">${rows.map(e=>`<article class="sp-row"><span class="sp-row-icon">${icon('exam')}</span><div><strong>${esc(e.title)}</strong><small>${esc(e.code)} · ${date(e.startAt)} · ${time(e.startAt)} – ${time(e.endAt)}</small><small>${esc((e.classes||[]).map(c=>c.code||c.name).join(', '))}</small></div>${phase(e)}${button(e.status==='RUNNING'?'Vào thi / Tiếp tục':states.includes('FINISHED')?'Xem chi tiết / Kết quả':'Xem chi tiết','open',e.status==='RUNNING'?'primary small':'outline small',`data-id="${esc(e.id)}" data-status="${esc(e.status)}"`)}</article>`).join('')||empty('Chưa có kỳ thi trong nhóm này')}</div></section>`;}).join('')}</div>${pagination('list',d.page||1,d.totalPages||1,d.total||0)}<p class="sp-hint">Kết quả bài thi chỉ hiển thị khi được công bố. Kỳ thi hoãn hoặc hủy sẽ có nhãn trạng thái riêng.</p></div>`;
}
function directory(teacher){
 if(!teacher)return studentDirectory();
 const data=o.directory,stats=data.stats||{},list=data.exams||[];
 return `${heading(teacher?"Tất cả kỳ thi":"Kỳ thi của tôi",teacher?"Quản lý các đợt thi lập trình và trạng thái tổ chức thi":"Xem lịch thi, xác nhận dự thi và theo dõi kết quả của bạn")}${teacher?`<div class="eo-stats">${stat("Tổng số kỳ thi",stats.total,"calendar")}${stat("Sắp diễn ra",stats.upcoming,"clock","amber")}${stat("Đang diễn ra",stats.running,"play","blue")}${stat("Đã kết thúc",stats.finished,"check","green")}</div>`:""}<section class="eo-card"><div class="eo-toolbar"><label class="eo-search">${icon("search")}<input id="eo-search" type="search" value="${esc(o.filters.query)}" placeholder="Tìm kiếm kỳ thi (mã kỳ thi, tên kỳ thi, lớp, học phần…)" aria-label="Tìm kỳ thi"></label>${select("eo-filter-status","Trạng thái",[["","Trạng thái: Tất cả"],...Object.entries(statuses)],o.filters.filterStatus)}${select("eo-filter-subject","Học phần",[["","Học phần: Tất cả"],...(data.subjects||[]).map(s=>[s,s])],o.filters.subject)}${select("eo-filter-format","Hình thức",[["","Hình thức: Tất cả"],...Object.entries(formats)],o.filters.format)}${teacher?button("Tạo kỳ thi","new","primary","","plus"):button("Làm mới","reload","outline","","history")}</div><p class="eo-hint eo-filter-note">Thống kê theo bộ lọc · ${data.total||0} kết quả · Đồng hồ server</p><div class="eo-table-wrap"><table class="eo-table"><thead><tr>${teacher?'<th><input id="eo-select-all" type="checkbox" aria-label="Chọn các kỳ thi trên trang"></th>':""}<th>${button("Mã kỳ thi ↕","sort","text",'data-sort="code"')}</th><th>Tên kỳ thi</th><th>Đề thi</th><th>Lớp/Đối tượng</th><th>Thời gian</th><th>Trạng thái</th><th>Thí sinh</th><th>Phòng thi</th><th>Thao tác</th></tr></thead><tbody>${list.map(e=>`<tr>${teacher?`<td><input type="checkbox" data-eo-select="${esc(e.id)}" ${checked(o.selected.has(e.id))} aria-label="Chọn ${esc(e.title||e.code)}"></td>`:""}<td><strong>${esc(e.code||"Chưa đặt mã")}</strong></td><td class="eo-title-cell"><button type="button" class="eo-title-link" data-action="eo-open" data-id="${esc(e.id)}" data-status="${e.status}">${esc(e.title||"Kỳ thi chưa đặt tên")}</button><small>${esc(e.description||e.subject||"Chưa có mô tả")}</small>${e.access==="PROCTOR"?badge("Được phân công coi thi","blue"):""}</td><td><span class="eo-tag">${icon("code")}${esc(e.examCode||"Chưa chọn đề")}${e.examVersion?` · v${e.examVersion}`:""}</span></td><td>${icon("users")} ${esc((e.classes||[]).map(c=>c.code||c.name).join(", ")||"—")}</td><td class="eo-date-cell">${icon("clock")}<span>${date(e.startAt)}<small>${time(e.startAt)} – ${time(e.endAt)}</small></span></td><td>${phase(e)}${e.locked?'<small class="eo-hint">Đang khóa nhận bài</small>':""}</td><td class="eo-center">${e.candidateCount??"—"}</td><td>${e.roomCount?icon("monitor")+` ${e.roomCount} phòng`:"—"}</td><td><div class="eo-row-tools">${tool("eye","open",e.id,"Xem kỳ thi",`data-status="${e.status}"`)}${teacher&&e.access==="OWNER"?`${tool("edit",e.status==="DRAFT"?"edit-draft":"edit",e.id,"Chỉnh sửa")}${e.status!=="DRAFT"?tool("copy","clone",e.id,"Nhân bản thành bản nháp"):""}`:""}${e.status!=="DRAFT"?tool("monitor","goto",e.id,"Mở giám sát",'data-view="monitor"'):""}${teacher?`<details class="eo-row-menu"><summary aria-label="Thao tác khác">${icon("more")}</summary><div>${e.status==="DRAFT"?button("Xóa bản nháp","delete-draft","text",`data-id="${esc(e.id)}" data-revision="${e.revision}"`):`${button("Phân công & phòng thi","goto","text",`data-id="${esc(e.id)}" data-view="assign"`)}${button("Chấm thi & kết quả","goto","text",`data-id="${esc(e.id)}" data-view="results"`)}${e.access==="OWNER"&&e.status==="SCHEDULED"?button("Tạm hoãn kỳ thi","control-dialog","text",`data-id="${esc(e.id)}" data-control="POSTPONE"`):""}${e.access==="OWNER"&&e.status==="POSTPONED"?button("Đặt lại lịch thi","control-dialog","text",`data-id="${esc(e.id)}" data-control="RESCHEDULE"`):""}${e.access==="OWNER"&&["SCHEDULED","POSTPONED"].includes(e.status)?button("Hủy kỳ thi","control-dialog","danger-text",`data-id="${esc(e.id)}" data-control="CANCEL"`):""}`}</div></details>`:""}</div></td></tr>`).join("")||`<tr><td colspan="10">${empty(o.filters.query||o.filters.filterStatus?"Không tìm thấy kỳ thi phù hợp":"Chưa có kỳ thi",teacher?"Chọn Tạo kỳ thi để tổ chức đợt thi đầu tiên.":"Kỳ thi sẽ xuất hiện khi bạn được giao.")}</td></tr>`}</tbody></table></div><footer class="eo-table-footer"><span>${teacher?`<strong>${o.selected.size?`Đã chọn ${o.selected.size} kỳ thi`:"Chưa chọn kỳ thi"}</strong>`:`${data.total||0} kỳ thi được giao`}</span><div>${teacher?`${button("Mở giám sát","bulk-monitor","outline",o.selected.size?"":"disabled","monitor")}${button("Xuất danh sách","export-exams","outline","","download")}${button("Công bố kết quả","bulk-publish","primary",o.selected.size?"":"disabled","send")}`:""}</div></footer>${pagination("list",data.page||1,data.totalPages||1,data.total||0)}</section>`;
}
function field(label,key,type="text",attrs=""){return `<label class="eo-field"><span>${label}</span><input id="eo-f-${key}" data-eo-field="${key}" type="${type}" value="${esc(o.draft?.document[key]??"")}" ${attrs}></label>`;}
function creator(){
 if(!o.draft)return empty("Đang mở bản nháp…");
 const d=o.draft.document,steps=["Thông tin kỳ thi","Chọn đề thi","Thí sinh & phòng thi","Quy chế & giám sát","Xem lại"],definition=o.definition||{};
 const parts=new Intl.DateTimeFormat("en-CA",{timeZone:d.timezone||"Asia/Bangkok",year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).formatToParts(new Date(d.startAt||Date.now()));const p=Object.fromEntries(parts.map(p=>[p.type,p.value]));
 const info=`<div class="eo-create-layout"><section class="eo-card eo-pad eo-form"><div class="eo-form-grid"><div>${field('Tên kỳ thi <em>*</em>',"title","text",'maxlength="120" required placeholder="Ví dụ: Kỳ thi giữa kỳ – Lập trình Java"')}</div><div>${field('Mã kỳ thi <em>*</em>',"code","text",'maxlength="64" required pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,63}"')}</div><label class="eo-field"><span>Đề thi áp dụng <em>*</em></span><select id="eo-f-examVersionId" data-eo-field="examVersionId"><option value="">Chọn đề thi đã duyệt</option>${o.sources.exams.map(e=>`<option value="${esc(e.id)}" ${d.examVersionId===e.id?"selected":""}>${esc(e.title)} (v${e.version}.0)</option>`).join("")}</select></label><label class="eo-field"><span>Học phần <em>*</em></span><input id="eo-f-subject" data-eo-field="subject" maxlength="120" list="eo-subjects" value="${esc(d.subject)}" placeholder="Tên học phần"><datalist id="eo-subjects">${(o.directory.subjects||[]).map(s=>`<option value="${esc(s)}">`).join("")}</datalist></label><div class="eo-full"><span class="eo-label">Lớp áp dụng <em>*</em></span><details class="eo-multiselect"><summary>${d.classIds.length?d.classIds.map(id=>`<span class="eo-chip">${esc(o.sources.classes.find(c=>c.id===id)?.code||id)}</span>`).join(""):"Chọn các lớp bạn quản lý"}${icon("chevron")}</summary><div>${o.sources.classes.filter(c=>!c.closed).map(c=>`<label><input type="checkbox" data-eo-class="${esc(c.id)}" ${checked(d.classIds.includes(c.id))}>${esc(c.code)} · ${esc(c.name)}</label>`).join("")||'<p class="eo-hint">Chưa có lớp đang mở. Tạo lớp trong Lớp học của tôi trước.</p>'}</div></details></div><div class="eo-full eo-three"><label class="eo-field"><span>Ngày thi <em>*</em></span><input id="eo-date" type="date" value="${p.year}-${p.month}-${p.day}" required></label><label class="eo-field"><span>Giờ bắt đầu <em>*</em></span><input id="eo-time" type="time" value="${p.hour}:${p.minute}" required></label>${field('Thời lượng (phút) <em>*</em>',"durationMinutes