 return `${heading("Giám sát kỳ thi","Theo dõi tình trạng làm bài, kết nối và sự cố trong thời gian thi","monitor")}${examSelector()}<div class="eo-monitor-banner">${strip()}<section class="eo-card eo-command-panel"><small>Thời gian còn lại</small><strong data-eo-countdown data-end="${e.latestEndAt||e.endAt}">${countdown(remaining)}</strong><div>${button("Gia hạn","control-dialog","outline",isOwner()?'data-control="EXTEND"':"disabled","clock")}${button(e.locked?"Mở khóa":"Khóa kỳ thi","control-dialog","outline",isOwner()?'data-control="LOCK"':"disabled","lock")}${button("Gửi thông báo","notify-dialog","primary","","send")}</div></section></div><div class="eo-stats">${stat("Tổng thí sinh",all.length,"users")}${stat("Đang làm bài",active,"monitor","green")}${stat("Đã kết thúc lượt",done,"file","amber")}${stat("Cần xem xét",warnings,"warning","red")}</div><div class="eo-monitor-grid"><section class="eo-card"><div class="eo-section-heading eo-pad"><h2>${icon("users")} Theo dõi thí sinh</h2>${button("Toàn màn hình","fullscreen","text small","","monitor")}</div><div class="eo-toolbar"><label class="eo-search">${icon("search")}<input id="eo-candidate-query" placeholder="Tìm theo mã SV, họ tên…" value="${esc(o.candidateQuery)}"></label>${select("eo-candidate-room","Phòng",[["","Phòng: Tất cả"],...(o.detail.rooms||[]).map(r=>[r.id,r.name])],o.candidateRoom)}${select("eo-monitor-status","Trạng thái thí sinh",[["","Trạng thái: Tất cả"],["NOT_STARTED","Chưa vào"],["ONLINE","Đang thi"],["OFFLINE","Mất kết nối"],["FINISHED","Đã kết thúc"]],o.monitorStatus)}<label class="eo-checkbox"><input id="eo-only-warnings" type="checkbox" ${checked(o.onlyWarnings)}> Chỉ hiển thị cảnh báo</label></div><div class="eo-table-wrap"><table class="eo-table"><thead><tr><th><input id="eo-candidate-all" type="checkbox" aria-label="Chọn thí sinh"></th><th>Mã SV</th><th>Họ tên</th><th>Phòng</th><th>Vào lượt thi</th><th>Tiến độ nộp</th><th>Trạng thái</th><th>Lượt nộp</th><th>Cảnh báo</th><th></th></tr></thead><tbody>${filtered.map(s=>{const signal=signals.get(s.userId)||{},total=s.assignedQuestions||e.problemCount||0,percent=total?Math.min(100,Math.round(100*s.submittedQuestions/total)):0,online=now-s.lastActivity<30000,status=s.finishedAt?"Đã kết thúc":!s.startedAt?"Chưa vào":online?"Đang thi":"Mất kết nối";return `<tr class="${signal.warning?"eo-warning-row":""}"><td><input type="checkbox" data-eo-candidate="${esc(s.userId)}" ${checked(o.candidates.has(s.userId))} aria-label="Chọn ${esc(s.displayName)}"></td><td>${esc(s.studentCode)}</td><td><strong>${esc(s.displayName)}</strong></td><td>${esc(s.roomName||"—")}</td><td>${s.startedAt?date(s.startedAt,{hour:"2-digit",minute:"2-digit"}):"—"}</td><td><div class="eo-progress-cell"><div class="eo-progress"><i style="width:${percent}%"></i></div><small>${s.submittedQuestions}/${total}</small></div></td><td>${badge(status,s.finishedAt?"blue":!s.startedAt?"gray":online?"green":"red")}</td><td class="eo-center">${s.attempts}</td><td>${signal.warning?badge("Cần xem xét","red"):"—"}</td><td>${tool("eye","candidate-detail",s.userId,"Xem chi tiết thí sinh")}</td></tr>`;}).join("")||`<tr><td colspan="10">${empty("Chưa có thí sinh phù hợp")}</td></tr>`}</tbody></table></div><p class="eo-hint eo-pad">${o.connected?"Đồng bộ qua WebSocket / polling dự phòng":"Mất kết nối · Đang hiển thị dữ liệu gần nhất"} · Cập nhật ${time(o.lastLoaded)} · Tiến độ là câu đã nộp, không đánh giá độ hoàn thành lời giải.</p></section><aside class="eo-card eo-pad"><div class="eo-section-heading"><h2>${icon("file")} Sự cố & nhật ký</h2>${button("Xem tất cả →","audit-dialog","text small")}</div><div class="eo-timeline">${[...(o.detail.monitor?.recentEvents||[]).map(v=>({title:v.displayName,detail:({TAB_SWITCH:"Rời trang / mất focus",TAB_RETURN:"Quay lại trang thi",PASTE_ATTEMPT:"Thao tác dán bị chặn"})[v.type]||v.type,at:v.receivedAt})),...(o.detail.audit||[]).slice(0,5).map(v=>({title:v.actor,detail:`${v.action} · ${v.detail}`,at:v.createdAt}))].sort((a,b)=>b.at-a.at).slice(0,7).map(v=>`<article><i>${icon("info")}</i><div><strong>${esc(v.title)}</strong><p>${esc(v.detail)}</p></div><time>${time(v.at)}</time></article>`).join("")||'<p class="eo-hint">Chưa có sự kiện. Tín hiệu không được tự xem là bằng chứng vi phạm.</p>'}</div></aside></div><div class="eo-bottom-grid"><section class="eo-card eo-pad"><h2>${icon("chart")} Tiến độ nộp bài theo phòng</h2>${[...new Set(all.map(s=>s.roomName||"Trực tuyến / chưa xếp"))].map(room=>{const rows=all.filter(s=>(s.roomName||"Trực tuyến / chưa xếp")===room),submitted=rows.filter(s=>s.submittedQuestions>0).length;return `<div class="eo-room-chart"><span>${esc(room)} (${rows.length})</span><div class="eo-progress"><i style="width:${rows.length?100*submitted/rows.length:0}%"></i></div><strong>${submitted}/${rows.length}</strong></div>`;}).join("")}</section><section class="eo-card eo-pad"><h2>${icon("clock")} Thống kê trạng thái</h2><div class="eo-status-chart"><div class="eo-donut" style="--portion:${all.length?360*done/all.length:0}deg"><div><strong>${all.length}</strong><small>Thí sinh</small></div></div><div><p>${badge(`Đang hoạt động: ${active}`,"green")}</p><p>${badge(`Đã kết thúc: ${done}`,"blue")}</p><p>${badge(`Chưa vào / offline: ${Math.max(0,all.length-active-done)}`,"gray")}</p></div></div></section><section class="eo-card eo-pad"><h2>${icon("play")} Thao tác nhanh</h2><div class="eo-quick-actions">${button("Mở hỗ trợ","notify-dialog","outline","","send")}${button("Xuất nhật ký","export-log","outline",isOwner()?"":"disabled","download")}${button("Kết thúc kỳ thi","control-dialog","primary",isOwner()?'data-control="END"':"disabled","stop")}</div></section></div>`;
}
export function countdown(ms){let s=Math.floor(ms/1000);return `${String(Math.floor(s/3600)).padStart(2,"0")}:${String(Math.floor(s/60)%60).padStart(2,"0")}:${String(s%60).padStart(2,"0")}`;}
function results(){const d=o.detail,stats=d.gradeStats||{},e=d.exam,analytics=d.analytics||{},scores=analytics.scores||[],scale=Number(e.totalPoints)||100,bins=Array.from({length:10},(_,i)=>scores.filter(n=>n>=i*scale/10&&(i===9?n<=scale:n<(i+1)*scale/10)).length),highest=Math.max(1,...bins),actions=`${button("Chấm lại","rejudge-dialog","outline",isOwner()?"":"disabled","history")}${button("Xuất điểm","export-results","outline",isOwner()?"":"disabled","download")}${button("Công bố kết quả","publish-dialog","primary",isOwner()?"":"disabled","send")}${button("In biên bản","print-results","outline","","file")}`;
 return `${heading("Chấm thi & kết quả","Quản lý bài nộp, điểm số và công bố kết quả kỳ thi","exam")}${examSelector()}<div class="eo-results-grid"><div><div class="eo-stats">${stat("Tổng bài nộp",stats.total,"code")}${stat("Đã chấm",stats.graded,"check","green")}${stat("Đang chấm lại",stats.rejudging,"history","amber")}${stat("Đã công bố",stats.published,"layers","blue")}</div><section class="eo-card"><div class="eo-result-exam"><strong>${esc(e.title)}</strong><span>${esc(e.code)} · ${phase(e)}</span></div><div class="eo-toolbar"><label class="eo-search">${icon("search")}<input id="eo-submission-query" value="${esc(o.submissionQuery)}" placeholder="Tìm mã nộp, mã SV, họ tên…"></label>${select("eo-result-exercise","Bài/Câu",[["","Bài/Câu: Tất cả"],...(d.resultExercises||[]).map(s=>[s,s])],o.exerciseId)}${select("eo-result-status","Trạng thái chấm",[["","Trạng thái: Tất cả"],["QUEUED","Chờ chấm"],["RUNNING","Đang chấm"],["DONE","Đã chấm"]],o.submissionStatus)}${select("eo-result-room","Phòng thi",[["","Phòng: Tất cả"],...(d.resultRooms||[]).map(s=>[s,s])],o.resultRoom)}${select("eo-result-verdict","Kết quả",[["","Kết quả: Tất cả"],...["AC","ACCEPTED","WA","WRONG_ANSWER","CE","TLE","RE","SANDBOX_UNAVAILABLE"].map(s=>[s,s])],o.verdict)}<label class="eo-score-range">Điểm: <input id="eo-min-score" type="number" min="0" placeholder="Từ" value="${esc(o.minScore)}">–<input id="eo-max-score" type="number" min="0" placeholder="Đến" value="${esc(o.maxScore)}"></label></div><div class="eo-table-wrap"><table class="eo-table"><thead><tr><th><input id="eo-submission-all" type="checkbox" aria-label="Chọn bài nộp trên trang"></th><th>Mã nộp</th><th>Mã SV</th><th>Họ tên</th><th>Bài/Câu</th><th>Điểm</th><th>Kết quả</th><th>Thời điểm nộp</th><th>Trạng thái chấm</th><th>Thao tác</th></tr></thead><tbody>${d.submissions.map(s=>`<tr><td><input type="checkbox" data-eo-submission="${esc(s.id)}" ${checked(o.submissions.has(s.id))} aria-label="Chọn bài ${esc(s.id)}"></td><td class="eo-short-id" title="${esc(s.id)}">${esc(s.id.slice(0,8).toUpperCase())}</td><td>${esc(s.studentCode||s.username)}</td><td><strong>${esc(s.displayName||s.username)}</strong></td><td title="${esc(s.exerciseTitle)}">${esc(s.exerciseId)}</td><td><strong>${s.score==null?"—":number(s.score)}</strong><small class="eo-hint"> / ${number(s.maxScore)}</small>${s.adjustmentReason?'<small class="eo-hint">Đã điều chỉnh</small>':""}</td><td>${badge(s.verdict,(["AC","ACCEPTED"].includes(s.verdict)?"green":["WA","WRONG_ANSWER","RE","RUNTIME_ERROR"].includes(s.verdict)?"red":"amber"))}</td><td>${date(s.submittedAt,{hour:"2-digit",minute:"2-digit"})}</td><td>${badge(s.status==="DONE"?"Đã chấm":s.rejudges?"Chấm lại":s.status==="RUNNING"?"Đang chấm":"Chờ chấm",s.status==="DONE"?"green":"purple")}</td><td><div class="eo-row-tools">${tool("eye","submission-detail",s.id,"Xem bài nộp")}${isOwner()?`${tool("history","rejudge-dialog",s.id,"Chấm lại bài này")}${tool("edit","adjust-dialog",s.id,"Điều chỉnh điểm")}`:""}</div></td></tr>`).join("")||`<tr><td colspan="10">${empty("Chưa có bài nộp phù hợp","Bài thi đã nhận sẽ xuất hiện ở đây cùng trạng thái chấm thật.")}</td></tr>`}</tbody></table></div>${pagination("submission",d.submissionPage||1,d.submissionPages||1,d.submissionTotal||0)}</section></div><aside><section class="eo-card eo-pad"><h2>${icon("chart")} Phổ điểm</h2><p class="eo-hint">Điểm cao nhất mỗi câu · 1 tổng điểm/thí sinh</p><div class="eo-histogram">${bins.map((n,i)=>`<div><span title="${n} thí sinh" style="height:${n?Math.max(4,100*n/highest):0}%"></span><small>${number(i*scale/10)}–${number((i+1)*scale/10)}</small></div>`).join("")}</div><div class="eo-chart-summary">Điểm TB: <b>${number(analytics.mean)}</b> · Trung vị: <b>${number(analytics.median)}</b> · Độ lệch: <b>${number(analytics.deviation)}</b></div></section><section class="eo-card eo-pad eo-spaced"><h2>${icon("layers")} Kết quả theo câu</h2>${(analytics.questions||[]).map(q=>`<div class="eo-question-result"><strong>${esc(q.id)}</