# Copy to .env (ignored). Fill secrets locally; never commit the real .env.
STUDYFIX_MANAGEMENT_DB=sqlite
STUDYFIX_SQLITE_MANAGEMENT_PATH=data/studyfix-management.db
# Optional one-time import from a legacy SQLite core; preserve user IDs and hashes.
STUDYFIX_SQLITE_IMPORT_CORE=false
STUDYFIX_BOOTSTRAP_TEACHER=
STUDYFIX_BOOTSTRAP_PASSWORD=
STUDYFIX_BOOTSTRAP_NAME=
STUDYFIX_WS_ENABLED=true
STUDYFIX_WS_PORT=8081
# Optional exact browser origins when using a reverse proxy, comma-separated.
STUDYFIX_WS_ALLOWED_ORIGINS=
# HTTPS/WSS: reuse the existing server keystore. Do not commit its password.
STUDYFIX_WEB_KEYSTORE=
STUDYFIX_WEB_KEYSTORE_PASSWORD=
